# Line endings.
#
# Without this, a clone on Windows can convert setup.sh to CRLF, and bash then
# fails with a confusing "\r: command not found" or "bad interpreter". Anyone
# using WSL would hit it immediately. Shell scripts and Python must stay LF.

* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.command text eol=lf

# Never touch these if they ever appear locally. The icon formats are here
# because packaging/icons.py writes them into build/ on every build, and a
# newline substitution would corrupt a container that is mostly PNG chunks.
*.apkg  binary
*.pdf   binary
*.docx  binary
*.png   binary
*.jpg   binary
*.ico   binary
*.icns  binary
*.dmg   binary
*.deb   binary
*.exe   binary
